{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Editor",
  "version": "0.1.0",
  "identifier": "com.orbiteditor.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 20,
          "y": 23
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "frame-src": "http://127.0.0.1:4321",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
